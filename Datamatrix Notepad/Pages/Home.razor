@page "/"
@implements IDisposable
@using Datamatrix_Notepad.Models
@using Datamatrix_Notepad.Services.Export
@using Datamatrix_Notepad.Services.Serial
@using Datamatrix_Notepad.Services.State
@inject AppStateService AppState
@inject NoteExportService NoteExport
@inject SerialPortService SerialPort

<PageTitle>Datamatrix Notepad</PageTitle>

<header class="page-header">
    <div>
        <h1>Datamatrix Notepad</h1>
        <p>Заметки для кодов со сканера DataMatrix</p>
    </div>
    <a class="text-link" href="settings">Настройки сканера</a>
</header>

<section class="connection-bar" aria-labelledby="scanner-connection-heading">
    <div>
        <h2 id="scanner-connection-heading">Сканер</h2>
        <p role="status" aria-live="polite">
            <span class="status-dot status-@SerialPort.State.ToString().ToLowerInvariant()"
                  aria-hidden="true"></span>
            <strong>@ConnectionStateText</strong>
            @if (SerialPort.SelectedPort is not null)
            {
                <span> — @CurrentPortLabel</span>
            }
        </p>
    </div>

    <div class="connection-actions">
        <button type="button"
                class="primary-button"
                @onclick="ConnectScannerAsync"
                disabled="@(!CanConnectScanner)">
            Выбрать порт
        </button>
        <button type="button"
                class="secondary-button"
                @onclick="DisconnectScannerAsync"
                disabled="@(_serialActionInProgress || SerialPort.State is not SerialConnectionState.Connected)">
            Отключить
        </button>
        <a class="text-link" href="settings">Параметры и диагностика</a>
    </div>
</section>

@if (_serialSupported is false)
{
    <p class="message message-error" role="alert">
        Web Serial недоступен. Используйте desktop Chrome или Edge по HTTPS.
    </p>
}
else if (_connectionHint is not null)
{
    <p class="message" role="status">@_connectionHint</p>
}

@if (_scanMessage is not null)
{
    <p class="message @(_scanMessageIsError ? "message-error" : null)"
       role="@(_scanMessageIsError ? "alert" : "status")">
        @_scanMessage
    </p>
}

@if (_isLoading)
{
    <p role="status" aria-busy="true">Загрузка заметок…</p>
}
else if (_loadResult is { IsSuccess: false })
{
    <section class="message message-error" role="alert">
        <h2>Не удалось загрузить заметки</h2>
        <p>@_loadResult.ErrorMessage</p>
        <p>Исходные данные не были перезаписаны.</p>
    </section>
}
else
{
    @if (_editorError is not null)
    {
        <p id="editor-error" class="message message-error" role="alert">
            @_editorError
        </p>
    }

    <div class="notepad-workspace">
        <aside class="notes-panel" aria-labelledby="notes-heading">
            <div class="panel-heading">
                <h2 id="notes-heading">Заметки</h2>
                <button @ref="_createNoteButton"
                        type="button"
                        class="primary-button"
                        @onclick="CreateNoteAsync">
                    Новая заметка
                </button>
            </div>

            <NoteList Notes="@AppState.State.Notes"
                      ActiveNoteId="@AppState.State.ActiveNoteId"
                      OnSelect="SelectNoteAsync"/>
        </aside>

        <section class="editor-panel" aria-label="Редактор заметки">
            @if (AppState.ActiveNote is { } activeNote)
            {
                <div @key="activeNote.Id" class="note-editor">
                    <div class="editor-toolbar">
                        <span>Редактирование заметки</span>
                        <div class="editor-actions">
                            <button type="button"
                                    class="primary-button"
                                    disabled="@_exportInProgress"
                                    @onclick="() => DownloadNoteAsync(activeNote)">
                                Скачать
                            </button>
                            <button type="button"
                                    class="danger-text-button"
                                    @ref="_deleteNoteButton"
                                    @onclick="() => RequestNoteDeletion(activeNote)">
                                Удалить заметку
                            </button>
                        </div>
                    </div>

                    <p class="export-file-name">
                        Имя файла: <code>@NoteExport.CreateFileName(activeNote)</code>
                    </p>
                    @if (_exportError is not null)
                    {
                        <p class="message message-error" role="alert">@_exportError</p>
                    }

                    <div class="field">
                        <label for="note-title">Название</label>
                        <input id="note-title"
                               type="text"
                               value="@activeNote.Title"
                               aria-describedby="@(_editorError is null ? null : "editor-error")"
                               @oninput="args => UpdateTitleAsync(activeNote.Id, args)"
                               autocomplete="off"/>
                    </div>

                    <div class="field field-grow">
                        <label for="note-content">Коды и текст заметки</label>
                        <textarea id="note-content"
                                  value="@activeNote.Content"
                                  aria-describedby="@(_editorError is null ? null : "editor-error")"
                                  @oninput="args => UpdateContentAsync(activeNote.Id, args)"
                                  spellcheck="false"></textarea>
                    </div>

                    <p class="save-status"
                       role="status"
                       aria-live="polite">
                        @PersistenceStatusText
                    </p>

                    @if (AppState.PersistenceError is not null)
                    {
                        <p class="message message-error" role="alert">
                            @AppState.PersistenceError
                        </p>
                    }
                </div>
            }
            else
            {
                <div class="empty-state" role="status">
                    <h2>Нет заметок</h2>
                    <p>Создайте заметку, чтобы вводить текст и принимать коды со сканера.</p>
                    <button type="button" class="primary-button" @onclick="CreateNoteAsync">
                        Создать заметку
                    </button>
                </div>
            }
        </section>
    </div>

    <ConfirmNoteDeletionDialog Note="@_notePendingDeletion"
                               OnCancel="CancelNoteDeletion"
                               OnConfirm="ConfirmNoteDeletionAsync"/>
}

@code {
    private bool _isLoading = true;
    private StateLoadResult? _loadResult;
    private Note? _notePendingDeletion;
    private bool? _serialSupported;
    private bool _serialActionInProgress;
    private string? _connectionHint;
    private string? _scanMessage;
    private bool _scanMessageIsError;
    private bool _exportInProgress;
    private string? _exportError;
    private string? _editorError;
    private ElementReference _deleteNoteButton;
    private ElementReference _createNoteButton;
    private bool _restoreFocusAfterDialog;

    private bool CanConnectScanner =>
        _serialSupported is true &&
        !_serialActionInProgress &&
        SerialPort.State is not SerialConnectionState.Connected;

    private string ConnectionStateText => SerialPort.State switch
    {
        SerialConnectionState.Disconnected => "не подключён",
        SerialConnectionState.Connecting => "подключение…",
        SerialConnectionState.Connected => "подключён",
        SerialConnectionState.Error => "ошибка подключения",
        _ => "неизвестно"
    };

    private string CurrentPortLabel =>
        SerialPort.SelectedPort is null
            ? AppState.State.SerialSettings.PortAlias
            : $"{AppState.State.SerialSettings.PortAlias} ({SerialPort.SelectedPort.DisplayName})";

    private string PersistenceStatusText => AppState.PersistenceStatus switch
    {
        StatePersistenceStatus.Saving => "Сохранение…",
        StatePersistenceStatus.Saved => "Сохранено",
        StatePersistenceStatus.Error => "Ошибка сохранения",
        _ => string.Empty
    };

    protected override async Task OnInitializedAsync()
    {
        AppState.StateChanged += HandleStateChanged;
        SerialPort.StateChanged += HandleStateChanged;
        SerialPort.ChunkReceived += HandleChunkReceived;
        _loadResult = await AppState.LoadAsync();
        _isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_restoreFocusAfterDialog)
        {
            _restoreFocusAfterDialog = false;
            if (AppState.ActiveNote is null)
            {
                await _createNoteButton.FocusAsync();
            }
            else
            {
                await _deleteNoteButton.FocusAsync();
            }
        }

        if (!firstRender || _loadResult is not { IsSuccess: true })
        {
            return;
        }

        try
        {
            _serialSupported = await SerialPort.IsSupportedAsync();
            if (_serialSupported is true)
            {
                await TryReconnectScannerAsync();
            }
        }
        catch (JSException exception)
        {
            _serialSupported = false;
            _connectionHint = exception.Message;
        }

        StateHasChanged();
    }

    private async Task CreateNoteAsync()
    {
        try
        {
            _editorError = null;
            await AppState.CreateNoteAsync();
        }
        catch (InvalidOperationException exception)
        {
            _editorError = exception.Message;
        }
    }

    private async Task SelectNoteAsync(Guid noteId)
    {
        await AppState.SelectNoteAsync(noteId);
    }

    private async Task UpdateTitleAsync(Guid noteId, ChangeEventArgs args)
    {
        var activeNote = AppState.State.Notes.Single(note => note.Id == noteId);
        try
        {
            _editorError = null;
            await AppState.UpdateNoteAsync(
                noteId,
                args.Value?.ToString() ?? string.Empty,
                activeNote.Content);
        }
        catch (ArgumentException exception)
        {
            _editorError = exception.Message;
        }
    }

    private async Task UpdateContentAsync(Guid noteId, ChangeEventArgs args)
    {
        var activeNote = AppState.State.Notes.Single(note => note.Id == noteId);
        try
        {
            _editorError = null;
            await AppState.UpdateNoteAsync(
                noteId,
                activeNote.Title,
                args.Value?.ToString() ?? string.Empty);
        }
        catch (ArgumentException exception)
        {
            _editorError = exception.Message;
        }
    }

    private void RequestNoteDeletion(Note note)
    {
        _notePendingDeletion = note;
    }

    private void CancelNoteDeletion()
    {
        _notePendingDeletion = null;
        _restoreFocusAfterDialog = true;
    }

    private async Task ConfirmNoteDeletionAsync()
    {
        if (_notePendingDeletion is not { } note)
        {
            return;
        }

        _restoreFocusAfterDialog = true;
        _notePendingDeletion = null;
        await AppState.DeleteNoteAsync(note.Id);
    }

    private async Task DownloadNoteAsync(Note note)
    {
        _exportInProgress = true;
        _exportError = null;
        try
        {
            await NoteExport.DownloadAsync(note);
        }
        catch (Exception exception)
        {
            _exportError = $"Не удалось скачать заметку: {exception.Message}";
        }
        finally
        {
            _exportInProgress = false;
        }
    }

    private async Task TryReconnectScannerAsync()
    {
        _serialActionInProgress = true;
        try
        {
            var settings = AppState.State.SerialSettings;
            var result = await SerialPort.TryReconnectAsync(
                settings.ToConnectionOptions(),
                new SerialPortInfo(
                    settings.UsbVendorId,
                    settings.UsbProductId));
            _connectionHint = result.Status switch
            {
                SerialReconnectStatus.Ambiguous =>
                    "Найдено несколько разрешённых портов. Выберите нужный порт.",
                SerialReconnectStatus.NotFound =>
                    "Разрешённый порт не найден. Выберите порт для сканера.",
                SerialReconnectStatus.Error => result.ErrorMessage,
                _ => null
            };
        }
        finally
        {
            _serialActionInProgress = false;
        }
    }

    private async Task ConnectScannerAsync()
    {
        if (!CanConnectScanner)
        {
            return;
        }

        _serialActionInProgress = true;
        _connectionHint = null;
        try
        {
            var settings = AppState.State.SerialSettings;
            var result = await SerialPort.SelectAndConnectAsync(
                settings.ToConnectionOptions());

            if (result.IsCancelled)
            {
                _connectionHint = "Выбор порта отменён.";
            }
            else if (result.IsConnected && result.Port is not null)
            {
                await AppState.UpdateSerialSettingsAsync(
                    settings with
                    {
                        UsbVendorId = result.Port.UsbVendorId,
                        UsbProductId = result.Port.UsbProductId
                    },
                    saveImmediately: true);
            }
            else
            {
                _connectionHint = result.ErrorMessage;
            }
        }
        finally
        {
            _serialActionInProgress = false;
        }
    }

    private async Task DisconnectScannerAsync()
    {
        _serialActionInProgress = true;
        try
        {
            await SerialPort.DisconnectAsync();
            _connectionHint = "Порт отключён.";
        }
        finally
        {
            _serialActionInProgress = false;
        }
    }

    private void HandleChunkReceived(object? sender, SerialChunkEventArgs args)
    {
        if (args.CompletedCodes.Count == 0)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            var result = await AppState.AppendScannedCodesAsync(
                args.CompletedCodes);
            (_scanMessage, _scanMessageIsError) = result.Status switch
            {
                ScanAppendStatus.Appended =>
                    ($"Добавлено кодов: {result.AppendedCount}.", false),
                ScanAppendStatus.NoActiveNote =>
                    ("Код получен, но активная заметка не выбрана.", true),
                ScanAppendStatus.ContentTooLarge =>
                    ("Код не добавлен: достигнут предел размера заметок.", true),
                _ => (null, false)
            };
            StateHasChanged();
        });
    }

    private void HandleStateChanged(object? sender, EventArgs args)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AppState.StateChanged -= HandleStateChanged;
        SerialPort.StateChanged -= HandleStateChanged;
        SerialPort.ChunkReceived -= HandleChunkReceived;
    }
}
